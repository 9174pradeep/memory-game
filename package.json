    "test:api": "node scripts/test-api.js",
    "test:browser": "node scripts/browser-test.js",
    "test:resilience": "node scripts/resilience-test.js",
    "test:all": "npm run lint && npm run test:api && npm run test:browser && npm run test:resilience"
  },
  "keywords": [
    "memory",
    "game",
    "express",
    "sqlite"
  ],
